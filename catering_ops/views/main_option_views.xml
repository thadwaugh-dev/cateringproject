<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_main_option_tree" model="ir.ui.view">
        <field name="name">catering.main.option.tree</field>
        <field name="model">catering.main.option</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_protein"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_catering_main_option_form" model="ir.ui.view">
        <field name="name">catering.main.option.form</field>
        <field name="model">catering.main.option</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="is_protein"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_catering_main_option" model="ir.actions.act_window">
        <field name="name">Main Options</field>
        <field name="res_model">catering.main.option</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
