<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_package_type_tree" model="ir.ui.view">
        <field name="name">catering.package.type.tree</field>
        <field name="model">catering.package.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_catering_package_type_form" model="ir.ui.view">
        <field name="name">catering.package.type.form</field>
        <field name="model">catering.package.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="rule_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="item_code"/>
                            <field name="apply_mode"/>
                            <field name="qty"/>
                            <field name="uom_name"/>
                            <field name="main_option_id"/>
                            <field name="is_addon"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_catering_package_type" model="ir.actions.act_window">
        <field name="name">Package Types</field>
        <field name="res_model">catering.package.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
