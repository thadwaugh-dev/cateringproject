<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_prep_sheet_tree" model="ir.ui.view">
        <field name="name">catering.prep.sheet.tree</field>
        <field name="model">catering.prep.sheet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="order_id"/>
                <field name="guest_count"/>
            </list>
        </field>
    </record>
    <record id="view_catering_prep_sheet_form" model="ir.ui.view">
        <field name="name">catering.prep.sheet.form</field>
        <field name="model">catering.prep.sheet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="order_id"/>
                        <field name="guest_count"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="item_code"/>
                            <field name="quantity"/>
                            <field name="uom_name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_catering_prep_sheet" model="ir.actions.act_window">
        <field name="name">Prep Sheets</field>
        <field name="res_model">catering.prep.sheet</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_catering_ops_root" name="Catering Ops" parent="sale.sale_menu_root" sequence="50"/>
    <menuitem id="menu_catering_package_type" name="Package Types" parent="menu_catering_ops_root" action="action_catering_package_type" sequence="10"/>
    <menuitem id="menu_catering_main_option" name="Main Options" parent="menu_catering_ops_root" action="action_catering_main_option" sequence="20"/>
    <menuitem id="menu_catering_package_rule" name="Rules" parent="menu_catering_ops_root" action="action_catering_package_rule" sequence="30"/>
    <menuitem id="menu_catering_prep_sheet" name="Prep Sheets" parent="menu_catering_ops_root" action="action_catering_prep_sheet" sequence="40"/>
</odoo>
