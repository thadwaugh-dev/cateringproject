<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_catering_ops" model="ir.ui.view">
        <field name="name">sale.order.form.catering.ops</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_catering_stripe_charge" type="object" string="Charge" class="btn-primary"
                    invisible="not catering_package_type_id or catering_paid"/>
            </xpath>
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="after">
                <field name="catering_venue_id" required="catering_package_type_id" placeholder="Delivery venue..."/>
                <field name="catering_preferred_venue_ids" widget="many2many_tags" readonly="1" invisible="not catering_preferred_venue_ids"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Catering" name="catering_ops">
                    <group string="Payment">
                        <field name="catering_paid" readonly="1"/>
                        <field name="catering_card_brand" readonly="1"/>
                        <field name="catering_card_last4" readonly="1"/>
                    </group>
                    <div class="alert alert-danger" role="alert" invisible="not catering_payment_error">
                        <field name="catering_payment_error" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="catering_package_type_id"/>
                            <field name="catering_guest_count"/>
                            <field name="catering_platter_total"/>
                            <field name="catering_platter_status"/>
                            <field name="catering_hummus"/>
                            <field name="catering_hummus_qty" invisible="not catering_hummus"/>
                            <field name="catering_pita_cut_style"/>
                            <field name="catering_pita_grilled" invisible="catering_pita_cut_style != 'split'"/>
                            <field name="catering_pita_fried" invisible="catering_pita_cut_style != 'split'"/>
                        </group>
                        <group string="Platter guests (must equal Guest count)">
                            <field name="catering_chicken_count"/>
                            <field name="catering_gyro_count"/>
                            <field name="catering_falafel_count"/>
                            <field name="catering_steak_count"/>
                            <field name="catering_salmon_count"/>
                            <field name="catering_lamb_count"/>
                        </group>
                    </group>
                    <group string="Desserts (qty 0 = off; multiple allowed)">
                        <field name="catering_cookie_qty"/>
                        <field name="catering_baklava_qty"/>
                        <field name="catering_mini_baklava_qty"/>
                        <field name="catering_dessert_triangle_qty"/>
                    </group>
                    <group string="Gallon tea (qty 0 = off; multiple allowed)">
                        <field name="catering_sweet_tea_qty"/>
                        <field name="catering_unsweet_tea_qty"/>
                        <field name="catering_needs_ice"/>
                    </group>
                    <group>
                        <button name="action_compute_catering_prep" type="object" string="Compute Prep Sheet" class="btn-primary"/>
                        <button name="action_open_food_sheet" type="object" string="Open Food Sheet" class="btn-secondary"/>
                        <button name="action_open_driver_sheet" type="object" string="Open Driver Pull Sheet" class="btn-secondary"/>
                    </group>
                    <separator string="Card payments"/>
                    <field name="catering_payment_ids" readonly="1">
                        <list create="false" delete="false" edit="false">
                            <field name="payment_date"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="status"/>
                            <field name="brand"/>
                            <field name="last4"/>
                            <field name="stripe_payment_intent_id"/>
                            <field name="error_message"/>
                        </list>
                    </field>
                    <separator string="Food Sheet (preview)"/>
                    <field name="catering_food_line_ids">
                        <list editable="bottom">
                            <field name="is_section" column_invisible="1"/>
                            <field name="category" optional="hide"/>
                            <field name="name"/>
                            <field name="qty_display" string="Qty"/>
                            <field name="quantity" column_invisible="1"/>
                            <field name="uom_name"/>
                        </list>
                    </field>
                    <separator string="Driver Pull Sheet (preview)"/>
                    <field name="catering_driver_line_ids">
                        <list editable="bottom">
                            <field name="is_section" column_invisible="1"/>
                            <field name="category" optional="hide"/>
                            <field name="name"/>
                            <field name="qty_display" string="Qty"/>
                            <field name="quantity" column_invisible="1"/>
                            <field name="uom_name"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_tree_catering_venue" model="ir.ui.view">
        <field name="name">sale.order.list.catering.venue</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="catering_venue_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_catering_venue" model="ir.ui.view">
        <field name="name">sale.order.search.catering.venue</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="catering_venue_id" string="Venue"/>
            </xpath>
            <xpath expr="//filter[@name='customer']" position="after">
                <filter string="Venue" name="group_catering_venue" context="{'group_by': 'catering_venue_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_catering_orders" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sale.view_sales_order_filter"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an order
            </p>
            <p>
                Search by customer or venue. A catering order (one with a package) needs both.
            </p>
        </field>
    </record>

    <menuitem id="menu_catering_orders"
        name="Orders"
        parent="menu_catering_ops_root"
        action="action_catering_orders"
        sequence="3"/>
</odoo>
